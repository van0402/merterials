model ApiKey {
  // API key admin cấp cho supplier/đối tác để gọi API từ bên ngoài.
  id         String        @id @default(cuid())
  name       String
  key        String?                          // chỉ hiện 1 lần lúc tạo, sau đó xoá để bảo mật
  keyHash    String        @unique @map("key_hash")  // hash để tra cứu, không lưu key gốc
  prefix     String                            // vài ký tự đầu, hiển thị cho user biết key nào
  userId     String        @map("user_id")
  scopes     Json          @default("[\"read\"]")   // quyền: read/write/admin
  rateLimit  Int           @default(100) @map("rate_limit") // số request/phút cho phép
  isActive   Boolean       @default(true) @map("is_active")
  lastUsedAt DateTime?     @map("last_used_at")
  expiresAt  DateTime?     @map("expires_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  usageLogs ApiUsageLog[]

  @@index([keyHash])
  @@index([userId])
  @@map("api_keys")
}

model ApiUsageLog {
  // Log từng lần gọi API bằng key ở trên — theo dõi hiệu năng/lỗi.
  id         String   @id @default(cuid())
  apiKeyId   String   @map("api_key_id")
  endpoint   String
  method     String
  statusCode Int      @map("status_code")
  responseMs Int      @map("response_ms")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([createdAt])
  @@index([endpoint])
  @@map("api_usage_logs")
}

model RateLimitEntry {
  // Đếm số request trong 1 khung thời gian (theo IP hoặc API key) để chặn spam/DDoS nhẹ.
  id           String   @id @default(cuid())
  identifier   String                          // API key hoặc IP
  endpoint     String
  windowStart  DateTime @map("window_start")
  requestCount Int      @default(0) @map("request_count")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([identifier, endpoint, windowStart])
  @@index([identifier])
  @@map("rate_limit_entries")
}