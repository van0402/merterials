model Inquiry {
  id                String        @id @default(cuid())
  supplierProfileId String        @map("supplier_profile_id")
  userId            String?       @map("user_id")
  materialId        String?       @map("material_id")
  guestName         String?       @map("guest_name")
  guestPhone        String?       @map("guest_phone")
  guestEmail        String?       @map("guest_email")
  message           String
  status            InquiryStatus @default(PENDING)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  supplierProfile SupplierProfile @relation(fields: [supplierProfileId], references: [id], onDelete: Cascade)
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  material        Material?       @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([supplierProfileId])
  @@map("inquiries")
}

enum InquiryStatus {
  PENDING
  RESPONDED
  CLOSED
}

model Review {
  id                String       @id @default(cuid())
  supplierProfileId String       @map("supplier_profile_id")
  userId            String       @map("user_id")
  rating            Int
  comment           String?
  status            ReviewStatus @default(PENDING)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  supplierProfile SupplierProfile @relation(fields: [supplierProfileId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([supplierProfileId, userId])
  @@index([supplierProfileId])
  @@map("reviews")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Favorite {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  supplierProfileId String   @map("supplier_profile_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplierProfile SupplierProfile @relation(fields: [supplierProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, supplierProfileId])
  @@map("favorites")
}