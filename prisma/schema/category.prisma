model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  parentId String? @map("parent_id")
  icon     String?
  isActive Boolean @default(true) @map("is_active")

  parent    Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[]         @relation("CategoryTree")
  suppliers SupplierCategory[]
  materials Material[]

  @@map("categories")
}

model SupplierCategory {
  id                String @id @default(cuid())
  supplierProfileId String @map("supplier_profile_id")
  categoryId        String @map("category_id")

  supplierProfile SupplierProfile @relation(fields: [supplierProfileId], references: [id], onDelete: Cascade)
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([supplierProfileId, categoryId])
  @@map("supplier_categories")
}

model Capability {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  isActive Boolean @default(true) @map("is_active")

  suppliers SupplierCapability[]

  @@map("capabilities")
}

model SupplierCapability {
  id                String @id @default(cuid())
  supplierProfileId String @map("supplier_profile_id")
  capabilityId      String @map("capability_id")

  supplierProfile SupplierProfile @relation(fields: [supplierProfileId], references: [id], onDelete: Cascade)
  capability      Capability      @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([supplierProfileId, capabilityId])
  @@map("supplier_capabilities")
}