model SupplierProfile {
  id            String         @id @default(cuid())
  userId        String?        @unique @map("user_id")
  companyName   String         @map("company_name")
  tradingName   String?        @map("trading_name")
  taxCode       String?        @unique @map("tax_code")
  description   String?
  foundedYear   Int?           @map("founded_year")
  businessTypes BusinessType[] @default([]) @map("business_types")
  mainMarket    MainMarket?    @map("main_market")
  companySize   CompanySize?   @map("company_size")
  logoUrl       String?        @map("logo_url")
  coverImageUrl String?        @map("cover_image_url")
  galleryImages Json    @default("[]") @map("gallery_images")
  phone         String
  contactName   String?        @map("contact_name")
  contactEmail  String?        @map("contact_email")
  website       String?
  address       String?
  province      String?
  district      String?
  country       String         @default("Việt Nam")
  industryRaw   String?        @map("industry_raw")
  status        SupplierStatus @default(PENDING)
  isVerified    Boolean        @default(false) @map("is_verified")
  reviewedBy    String?        @map("reviewed_by")
  reviewedAt    DateTime?      @map("reviewed_at")
  reviewNotes   String?        @map("review_notes")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  user         User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories   SupplierCategory[]
  capabilities SupplierCapability[]
  materials    Material[]
  documents    SupplierDocument[]
  reviews      Review[]
  inquiries    Inquiry[]
  favorites    Favorite[]
  sourcingQuotes SourcingQuote[]
  @@index([status])
  @@map("supplier_profiles")
}

enum SupplierStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model SupplierDocument {
  id                String         @id @default(cuid())
  supplierProfileId String         @map("supplier_profile_id")
  type              DocumentType
  fileUrl           String         @map("file_url")
  status            DocumentStatus @default(PENDING)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  supplierProfile SupplierProfile @relation(fields: [supplierProfileId], references: [id], onDelete: Cascade)

  @@index([supplierProfileId])
  @@map("supplier_documents")
}

enum DocumentType {
  BUSINESS_LICENSE
  QUALITY_CERT
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BusinessType {
  MANUFACTURER
  DISTRIBUTOR
  IMPORTER
  OEM_ODM
  SYSTEM_INTEGRATOR
  TECHNICAL_SERVICE
}

enum MainMarket {
  NATIONWIDE
  NORTH
  CENTRAL
  SOUTH
  EXPORT
}

enum CompanySize {
  UNDER_10
  FROM_10_TO_50
  FROM_51_TO_200
  FROM_201_TO_500
  OVER_500
}
