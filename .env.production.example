# Production env for https://affiliate.smee.vn
# Copy to .env on VPS or run compose with --env-file .env

NODE_ENV=production

# Public URLs baked into Next frontend during build.
NEXT_PUBLIC_APP_URL=https://affiliate.smee.vn
NEXT_PUBLIC_SITE_URL=https://affiliate.smee.vn
NEXT_PUBLIC_SOCKET_URL=https://affiliate.smee.vn

# Public traffic is HTTPS, so auth cookie should be Secure.
# If temporarily testing direct http://IP:8300, set this to false.
AUTH_COOKIE_SECURE=true

# PostgreSQL inside docker network.
POSTGRES_USER=refferq
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=refferq
DATABASE_URL=postgresql://refferq:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/refferq

# Secrets. Generate fresh values and do not commit real secrets.
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS
WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_WEBHOOK_SECRET
CRON_SECRET=CHANGE_ME_LONG_RANDOM_CRON_SECRET

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=marketing@smee.vn
ADMIN_EMAILS=admin@smee.vn

# Seed/admin
SEED_ADMIN_EMAIL=admin@smee.vn
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Optional integrations
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_GA_ID=
