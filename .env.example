# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://refferq:refferq@localhost:5432/refferq

# Authentication
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters

# Transactional email (Resend)
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=SMEE <noreply@example.com>
ADMIN_EMAILS=admin@example.com

# Signed inbound webhooks and scheduled commission maturation
# Generate each value independently with: openssl rand -hex 32
WEBHOOK_SECRET=replace-with-a-random-webhook-secret
CRON_SECRET=replace-with-a-random-cron-secret

# Initial data; change before running npm run db:seed
SEED_ADMIN_EMAIL=admin@smee.vn
SEED_ADMIN_PASSWORD=replace-this-before-seeding

# Optional integrations
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_GA_ID=
